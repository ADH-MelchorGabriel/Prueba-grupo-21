@model TareaEntity

<div class="row">
	<div class="col-12">
		<h2>Nueva tarea</h2>
	</div>
</div>


<div class="row">
	<div class="col-12">
		<form method="post" asp-controller="Tareas" asp-action="Nuevo">

			<div class="">
				<label>Tarea</label>
				<input type="text" class="form-control" asp-for="@Model.Tarea" />
			</div>
			<div class="">
				<label>Descripcion</label>
				<input type="text" class="form-control" asp-for="@Model.Descripcion" />
			</div>
			<div class="">
				<a class="btn btn-secondary" asp-controller="Tareas" asp-action="Index">Salir</a>
				<input class="btn btn-success" type="submit" value="Guardar" />
			</div>

		</form>
	</div>
</div>